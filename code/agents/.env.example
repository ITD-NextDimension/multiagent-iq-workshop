# Azure OpenAI (see python/samples/02-agents/providers/azure)
AZURE_OPENAI_ENDPOINT=https://my-ai-foundry.services.ai.azure.com/
AZURE_OPENAI_MODEL=gpt-5.5
# AZURE_OPENAI_API_VERSION=2024-10-21

# Auth option A: API key
# AZURE_OPENAI_API_KEY=

# Auth option B (recommended): leave AZURE_OPENAI_API_KEY empty and run `az login`
# so the app uses AzureCliCredential.

# Azure Communication Services Email
# Get the connection string from the Communication Services resource, and use
# a MailFrom address from a connected/verified Email Communication Services domain.
AZURE_COMMUNICATION_SERVICE_CONNECTION_STRING=
AZURE_COMMUNICATION_SERVICE_SENDER_ADDRESS=DoNotReply@<your-verified-domain>
