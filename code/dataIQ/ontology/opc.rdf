<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xml:base="http://example.org/ontology/opc/"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:ont="http://example.org/ontology/opc/">

    <owl:Ontology rdf:about="http://example.org/ontology/opc/">
        <rdfs:label>OPC One-Person Company</rdfs:label>
        <rdfs:comment>One-Person-Company business ontology for Microsoft Fabric IQ: Project, BankAccount, Task.</rdfs:comment>
    </owl:Ontology>

    <!-- ===================== -->
    <!-- Entity Types (Classes) -->
    <!-- ===================== -->

    <owl:Class rdf:about="http://example.org/ontology/opc/Project">
        <rdfs:label>Project</rdfs:label>
        <rdfs:comment>A client engagement with a status</rdfs:comment>
        <ont:icon>📁</ont:icon>
        <ont:color>#107C10</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/opc/BankAccount">
        <rdfs:label>BankAccount</rdfs:label>
        <rdfs:comment>A bank or wallet account funding projects</rdfs:comment>
        <ont:icon>🏦</ont:icon>
        <ont:color>#C19C00</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/opc/Task">
        <rdfs:label>Task</rdfs:label>
        <rdfs:comment>A unit of work inside a project</rdfs:comment>
        <ont:icon>✅</ont:icon>
        <ont:color>#498205</ont:color>
    </owl:Class>

    <!-- ================ -->
    <!-- Data Properties  -->
    <!-- ================ -->

    <!-- Project -->
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/opc/project_projectId">
        <rdfs:label>projectId</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/opc/Project"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/opc/project_name">
        <rdfs:label>name</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/opc/Project"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/opc/project_status">
        <rdfs:label>status</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/opc/Project"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/opc/project_budget">
        <rdfs:label>budget</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/opc/Project"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <ont:unit>CNY</ont:unit>
        <ont:propertyType>decimal</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/opc/project_startDate">
        <rdfs:label>startDate</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/opc/Project"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <ont:propertyType>date</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/opc/project_dueDate">
        <rdfs:label>dueDate</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/opc/Project"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <ont:propertyType>date</ont:propertyType>
    </owl:DatatypeProperty>

    <!-- BankAccount -->
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/opc/bankAccount_accountId">
        <rdfs:label>accountId</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/opc/BankAccount"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/opc/bankAccount_bankName">
        <rdfs:label>bankName</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/opc/BankAccount"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/opc/bankAccount_accountType">
        <rdfs:label>accountType</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/opc/BankAccount"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/opc/bankAccount_balance">
        <rdfs:label>balance</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/opc/BankAccount"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <ont:unit>CNY</ont:unit>
        <ont:propertyType>decimal</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/opc/bankAccount_currency">
        <rdfs:label>currency</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/opc/BankAccount"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <!-- Task -->
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/opc/task_taskId">
        <rdfs:label>taskId</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/opc/Task"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/opc/task_title">
        <rdfs:label>title</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/opc/Task"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/opc/task_priority">
        <rdfs:label>priority</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/opc/Task"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/opc/task_status">
        <rdfs:label>status</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/opc/Task"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/opc/task_estimateHours">
        <rdfs:label>estimateHours</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/opc/Task"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <ont:unit>hours</ont:unit>
        <ont:propertyType>decimal</ont:propertyType>
    </owl:DatatypeProperty>

    <!-- ================== -->
    <!-- Object Properties  -->
    <!-- ================== -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology/opc/account_funds_project">
        <rdfs:label>funds</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/opc/BankAccount"/>
        <rdfs:range rdf:resource="http://example.org/ontology/opc/Project"/>
        <rdfs:comment>Bank account funds projects</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>bankAccount</ont:fromEntityId>
        <ont:toEntityId>project</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/opc/project_has_task">
        <rdfs:label>has_task</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/opc/Project"/>
        <rdfs:range rdf:resource="http://example.org/ontology/opc/Task"/>
        <rdfs:comment>Project contains tasks</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>project</ont:fromEntityId>
        <ont:toEntityId>task</ont:toEntityId>
    </owl:ObjectProperty>

</rdf:RDF>
