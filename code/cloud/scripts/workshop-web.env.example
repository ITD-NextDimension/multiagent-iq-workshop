# Lab 05-1 · 共享资源配置（讲师课前填好，发给学员）
#
# 用法：
#   cp workshop-web.env.example workshop-web.env
#   # 填入下面的值，然后把 workshop-web.env 发给学员
#   bash deploy-web-only.sh <你的应用名>
#
# workshop-web.env 已被 .gitignore 排除 —— 里面是真实的订阅和资源标识，
# 不要提交，也不要贴进聊天群的公开频道。
#
# 这些资源全部由讲师课前创建并维护，学员不创建、不删除。

# ---- Azure 订阅与登录 --------------------------------------------------------
# 学员用讲师发的实验服务主体登录，不用自己的 Azure 账号。
# 服务主体需要在下面这个资源组上有 Contributor 角色。
AZURE_SUBSCRIPTION_ID="<subscription-id>"
AZURE_TENANT_ID="<tenant-id>"
AZURE_CLIENT_ID="<service-principal-client-id>"
# 客户端密码不写在这里。脚本运行时会隐藏输入，让学员现场粘贴。

# ---- 共享资源组与区域 --------------------------------------------------------
AZURE_RESOURCE_GROUP="<resource-group>"
AZURE_LOCATION="<region>"

# ---- 讲师预置的共享资源 ------------------------------------------------------
# Container Apps 环境（学员的 Web App 建在这里面）
ACA_ENV_NAME="<container-apps-environment>"

# ACR 登录服务器与 Web 镜像标签
ACR_LOGIN_SERVER="<registry>.azurecr.io"
WEB_IMAGE_TAG=workshop

# 拥有 AcrPull 权限的用户分配托管身份（学员的 App 靠它拉镜像）
REGISTRY_IDENTITY_NAME="<managed-identity-name>"

# 共享 AKS 上 Agent API 的地址，nginx 反向代理指向它。
# 学员浏览器访问的始终是自己的 HTTPS 地址，不会直连这个 IP。
AGENTS_BACKEND_URL="http://<aks-external-ip>"
