# 容器与部署脚本必须是 LF。Windows 的 Git 默认 core.autocrlf=true，
# 本地 Dev Containers 路线会把宿主机目录挂进容器，CRLF 会让 bash 报
#   set: pipefail<CR>: invalid option name
# 而且后续每一行都变成 $'\r': command not found。
*.sh            text eol=lf
*.bash          text eol=lf

# .env 模板同理：CRLF 会让 python-dotenv 把 \r 读进 endpoint 的值里，
# 表现为一个很难查的 Azure 调用失败。
.env.example    text eol=lf
*.env.example   text eol=lf

# Windows 侧的脚本保持 CRLF。
*.ps1           text eol=crlf

# 二进制，不要做任何行尾转换。
*.png           binary
*.pptx          binary
*.pdf           binary
*.zip           binary
